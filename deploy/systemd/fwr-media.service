[Unit]
Description=Robot camera MJPEG server (ROS image -> phone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=manbaout
WorkingDirectory=/home/manbaout/Company_Project/Four-wheel-robot
# 相机由 fwr-camera.service 独占（/dev/video0），这里只订阅 ROS 话题；
# 相机没起来时先出测试图案，真实帧一到自动切走。
# 第二路 120° 广角相机（/dev/video/by-id 自动找）：--wide-* 控制它。
#   --wide-width 480   送到手机前缩到 480 宽（4G 只有 ~3.5 Mbps）
#   --wide-fps 20      发送上限，和主摄 ~19 fps 对齐
#   --wide-quality 60  重编码画质（越小越省流量）
#   --wide-cam-fps 30  显式让相机按 30 fps 出流（不设时部分 UVC 相机会停在 10 fps）
ExecStart=/bin/bash -lc "source /opt/ros/humble/setup.bash && source ros2_ws/install/setup.bash && exec ./.venv/bin/python tools/robot_mjpeg_server.py --port 8081 --fps 0 --quality 70 --width 480 --wide-width 480 --wide-fps 20 --wide-quality 60 --wide-cam-fps 30 --fallback-test-pattern"
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target

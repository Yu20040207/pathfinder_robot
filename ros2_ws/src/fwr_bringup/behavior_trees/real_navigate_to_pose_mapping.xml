<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- 2026-11-04 建图专用（导航仍用 real_navigate_to_pose.xml，完全不受影响）。

         目的：减少"中途改道"（用户反馈：规划好的路走到一半又规划出更合适的，
         然后车拐过去，表现为一下左拐一下右拐）。

         做法：把重规划周期从 0.5 Hz（2 秒）降到 0.2 Hz（5 秒）。
         改道机会减少 60%，同时**保证一定会规划**。

         ⚠️ 两个失败的尝试（别再重做）：
         1. `Inverter(IsPathValid)` → 空路径时 IsPathValid 返回 SUCCESS，
            被反转成 FAILURE → 跳过规划 → 车完全不动（/plan 0 次）
         2. `Fallback(IsPathValid, ComputePathToPose)` → 同样因为空路径被判"有效"
            而永远不规划 → 车完全不动
         → Hamble 的 IsPathValid 对空路径不可靠，不能用来做"是否需要规划"的判据。
    -->
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="0.2">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <Sequence name="RecoveryActions">
        <Spin spin_dist="1.05" name="RecoverySpin"/>
        <Wait wait_duration="1.0"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>

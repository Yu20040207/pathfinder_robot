Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: fwr_rviz_nav/TwoPointNavPanel
    Name: 单点/两点导航
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.4
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 30
      Color: 150; 150; 150
      Value: true
    - Class: rviz_default_plugins/Map
      Name: 走廊静态地图
      Enabled: true
      Alpha: 0.65
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: C1 LaserScan points
      Enabled: true
      Topic: /scan
      Style: Flat Squares
      Size (Pixels): 4
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 80; 50
      Alpha: 1
      Decay Time: 0.2
      Queue Size: 10
      Position Transformer: XYZ
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.6
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Nav2 Global Path
      Enabled: true
      Color: 255; 220; 0
      Line Style: Lines
      Line Width: 0.04
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Class: rviz_default_plugins/Path
      Name: 两点规划预览
      Enabled: true
      Color: 40; 230; 100
      Line Style: Lines
      Line Width: 0.05
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /two_point_preview_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: 起点与终点
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /two_point_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0
      Pitch: 1.55
      Target Frame: map
      Yaw: 0
      Value: Orbit (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Width: 1400
  Height: 900
  X: 100
  Y: 60

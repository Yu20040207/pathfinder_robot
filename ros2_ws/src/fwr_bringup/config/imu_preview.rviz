Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane: XY
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Second-generation CAD preview
      Enabled: true
      Description Source: Topic
      Description File: ""
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Pose
      Name: Robot front (IMU +X)
      Enabled: true
      Shape: Arrow
      Color: 255; 170; 0
      Shaft Length: 0.20
      Shaft Radius: 0.01
      Head Length: 0.06
      Head Radius: 0.025
      Topic:
        Value: /imu/pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Value: true
  Enabled: true
  Global Options:
    Fixed Frame: imu_preview
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.3
      Focal Point:
        X: 0
        Y: 0
        Z: 0.12
      Pitch: 0.7
      Target Frame: imu_preview
      Yaw: 0.8
      Value: Orbit (rviz)

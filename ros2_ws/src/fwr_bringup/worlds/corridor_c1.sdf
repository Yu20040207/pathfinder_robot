<?xml version="1.0"?>
<sdf version="1.8">
  <world name="corridor">
    <physics name="step" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.8 0.85 0.9 1</background><shadows>false</shadows></scene>
    <gui fullscreen="0"><camera name="user_camera"><pose>-1.5 -1.5 1.4 0 0.45 0.75</pose><view_controller>orbit</view_controller></camera></gui>
    <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 -0.3 -1</direction></light>
    <model name="corridor_geometry"><static>true</static>
      <link name="floor"><pose>3 0 -0.05 0 0 0</pose><collision name="collision"><geometry><box><size>12 4 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 4 0.1</size></box></geometry></visual></link>
      <link name="left_wall"><pose>3 1.35 0.55 0 0 0</pose><collision name="collision"><geometry><box><size>12 0.12 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.12 1.1</size></box></geometry></visual></link>
      <link name="right_wall"><pose>3 -1.35 0.55 0 0 0</pose><collision name="collision"><geometry><box><size>12 0.12 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.12 1.1</size></box></geometry></visual></link>
      <link name="end_wall"><pose>8.9 0 0.55 0 0 0</pose><collision name="collision"><geometry><box><size>0.12 2.7 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.12 2.7 1.1</size></box></geometry></visual></link>
      <link name="obstacle"><pose>3.2 -0.45 0.3 0 0 0</pose><collision name="collision"><geometry><box><size>0.55 0.55 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.55 0.55 0.6</size></box></geometry></visual></link>
    </model>
    <!-- Dimensions and C1 position follow the current RViz chassis preview; not final CAD. -->
    <model name="fwr_chassis"><pose>0 0 0.005 0 0 0</pose>
      <link name="base_link">
        <inertial><pose>0 0 0.12 0 0 0</pose><mass>12</mass><inertia><ixx>0.16</ixx><iyy>0.30</iyy><izz>0.39</izz></inertia></inertial>
        <collision name="body_collision"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.52 0.35 0.16</size></box></geometry></collision>
        <visual name="body_visual"><pose>0 0 0.12 0 0 0</pose><geometry><mesh><uri>model://fwr_bringup/description/fwr_chassis_rounded.stl</uri></mesh></geometry><material><ambient>0.12 0.35 0.68 0.72</ambient><diffuse>0.12 0.35 0.68 0.72</diffuse></material><transparency>0.28</transparency></visual>
        <collision name="caster_left"><pose>0.19 0.115 0.04 0 0 0</pose><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.005</mu><mu2>0.005</mu2></ode></friction></surface></collision>
        <collision name="caster_right"><pose>0.19 -0.115 0.04 0 0 0</pose><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.005</mu><mu2>0.005</mu2></ode></friction></surface></collision>
        <visual name="caster_left_stem"><pose>0.19 0.115 0.075 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry><material><ambient>0.52 0.56 0.62 1</ambient><diffuse>0.52 0.56 0.62 1</diffuse></material></visual>
        <visual name="caster_right_stem"><pose>0.19 -0.115 0.075 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry><material><ambient>0.52 0.56 0.62 1</ambient><diffuse>0.52 0.56 0.62 1</diffuse></material></visual>
        <visual name="caster_left_visual"><pose>0.165 0.115 0.04 1.57079632679 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.52 0.56 0.62 1</ambient><diffuse>0.52 0.56 0.62 1</diffuse></material></visual>
        <visual name="caster_right_visual"><pose>0.165 -0.115 0.04 1.57079632679 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.52 0.56 0.62 1</ambient><diffuse>0.52 0.56 0.62 1</diffuse></material></visual>
      </link>
      <link name="left_drive_wheel"><pose>-0.13 0.145 0.05 1.57079632679 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.00035</ixx><iyy>0.00035</iyy><izz>0.0005</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry><material><ambient>0.10 0.12 0.16 1</ambient><diffuse>0.10 0.12 0.16 1</diffuse></material></visual></link>
      <link name="right_drive_wheel"><pose>-0.13 -0.145 0.05 1.57079632679 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.00035</ixx><iyy>0.00035</iyy><izz>0.0005</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.05</radius><length>0.035</length></cylinder></geometry><material><ambient>0.10 0.12 0.16 1</ambient><diffuse>0.10 0.12 0.16 1</diffuse></material></visual></link>
      <joint name="left_drive_joint" type="revolute"><parent>base_link</parent><child>left_drive_wheel</child><axis><xyz>0 0 -1</xyz><limit><lower>-100000</lower><upper>100000</upper><effort>10</effort><velocity>30</velocity></limit></axis></joint>
      <joint name="right_drive_joint" type="revolute"><parent>base_link</parent><child>right_drive_wheel</child><axis><xyz>0 0 -1</xyz><limit><lower>-100000</lower><upper>100000</upper><effort>10</effort><velocity>30</velocity></limit></axis></joint>
      <link name="laser_front"><pose>0.19 0 0.2298 0 0 0</pose><inertial><mass>0.11</mass><inertia><ixx>0.0000439</ixx><iyy>0.0000439</iyy><izz>0.0000567</izz></inertia></inertial><collision name="collision"><pose>0 0 -0.00915 0 0 0</pose><geometry><box><size>0.0556 0.0556 0.0413</size></box></geometry></collision><visual name="base_visual"><pose>0 0 -0.01825 0 0 0</pose><geometry><box><size>0.0556 0.0556 0.0231</size></box></geometry><material><ambient>0.23 0.25 0.29 1</ambient><diffuse>0.23 0.25 0.29 1</diffuse></material></visual><visual name="rotor_visual"><pose>0 0 0.0024 0 0 0</pose><geometry><cylinder><radius>0.0215</radius><length>0.0182</length></cylinder></geometry><material><ambient>0.04 0.05 0.07 1</ambient><diffuse>0.04 0.05 0.07 1</diffuse></material></visual>
        <sensor name="c1_scan" type="gpu_lidar"><always_on>true</always_on><update_rate>10</update_rate><topic>/scan</topic><ignition_frame_id>laser_front</ignition_frame_id><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.12</min><max>12</max><resolution>0.01</resolution></range></lidar></sensor>
      </link>
      <joint name="laser_front_joint" type="fixed"><parent>base_link</parent><child>laser_front</child></joint>
      <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_drive_joint</left_joint><right_joint>right_drive_joint</right_joint><wheel_separation>0.29</wheel_separation><wheel_radius>0.05</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>20</odom_publish_frequency></plugin>
      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic><joint_name>left_drive_joint</joint_name><joint_name>right_drive_joint</joint_name></plugin>
    </model>
  </world>
</sdf>
